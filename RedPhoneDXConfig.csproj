<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
	<OutputType>Exe</OutputType>
	<TargetFramework>net8.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<PlatformTarget>AnyCPU</PlatformTarget>
	<Copyright>Underwater communication &amp; navigation laboratory, LLC</Copyright>
	<Company>Underwater communication &amp; navigation laboratory, LLC</Company>
	<Description>RedPhone underwater telephone configuration application</Description>
	<AssemblyVersion>1.0.0.0</AssemblyVersion>
	<FileVersion>1.0.0.0</FileVersion>
	<MajorVersion>2</MajorVersion>
	<MinorVersion>0</MinorVersion>
	<PatchVersion>0</PatchVersion>
	<BuildNumber Condition=" '$(BuildNumber)' == '' ">$([System.DateTime]::Now.ToString("HHmm"))</BuildNumber>
	<Version>$(MajorVersion).$(MinorVersion).$(PatchVersion).$(BuildNumber)</Version>
	<LangVersion>12.0</LangVersion>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.8" />
    <PackageReference Include="UCNLDrivers" Version="1.1.3" />
  </ItemGroup>

  <ItemGroup>
	<EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

</Project>
